# 复制这个文件为 .env，然后填上真实的值
# （.env 已被 .gitignore 忽略，不会进版本库）

# 对话模型：DeepSeek
DEEPSEEK_API_KEY=在这里填你的 DeepSeek API Key

# 向量化模型：硅基流动（BAAI/bge-m3）
SILICONFLOW_API_KEY=在这里填你的硅基流动 API Key

# MySQL 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=shop

# 登录令牌（JWT）的签名密钥：随便一串长随机字符
# 生成方法：python -c "import secrets; print(secrets.token_hex(32))"
# 换掉它 = 所有已发出的令牌立刻失效（相当于强制所有人重新登录）
JWT_SECRET=在这里填一串随机字符
